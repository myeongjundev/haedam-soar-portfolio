# Personal pfSense lab (project haedam-pf-lab). Create the real file with:
#   py -3.12 tools/pf_lab.py init --iso PATH\pfSense-CE-2.7.2-RELEASE-amd64.iso
# init generates the MySQL values; the real .env.pf is local only and ignored by Git.
MYSQL_ROOT_PASSWORD=generated-by-init
MYSQL_PASSWORD=generated-by-init
# Loopback port of the portal on the host (the lab clients reach it through pfSense instead).
PORTAL_PORT=25020
# Local pfSense CE 2.7.2 installer ISO, mounted read-only into the QEMU container. Not in Git.
PFSENSE_ISO=D:/path/to/pfSense-CE-2.7.2-RELEASE-amd64.iso
# Addresses, interfaces, ports and paths are not set here: see infra/pfsense/lab-settings.json
# (or point PF_LAB_SETTINGS at another settings file).
# S10 (tools/s10_lab.py init adds these; values are generated locally and never printed).
GRAYLOG_ADMIN_PASSWORD=generated-by-init
GRAYLOG_PASSWORD_SECRET=generated-by-init
GRAYLOG_ROOT_PASSWORD_SHA2=derived-by-init
N8N_ENCRYPTION_KEY=generated-by-init
TICKET_STORE_KEY=generated-by-init
PORTAL_RESPONSE_KEY=generated-by-init
S10_DETECTION_KEY=generated-by-init
S10_OPERATOR_KEY=generated-by-init
PF_RELAY_KEY=generated-by-init
# Loopback ports for Graylog, n8n, the ticket dashboard and the portal GELF input.
GRAYLOG_PORT=19140
N8N_PORT=15740
TICKET_PORT=18140
GELF_PORT=22340
