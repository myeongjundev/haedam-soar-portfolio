# Use the setup guide to generate these values on the local machine.
GRAYLOG_ADMIN_PASSWORD=
# Graylog encryption secret.
GRAYLOG_PASSWORD_SECRET=
# SHA-256 of the Graylog admin password.
GRAYLOG_ROOT_PASSWORD_SHA2=
# n8n credential encryption key.
N8N_ENCRYPTION_KEY=
# Ticket API response key.
TICKET_STORE_KEY=

# Published to loopback only.
GRAYLOG_PORT=19000
GELF_PORT=22201
N8N_PORT=15678
TICKET_PORT=18089
