{
  "title": "Portfolio S7 trusted FIM",
  "description": "Personal fixed-path FIM response; excludes baseline restoration events. Not the team HTTP-access correlation policy.",
  "priority": 2,
  "alert": true,
  "config": {
    "type": "aggregation-v1",
    "query": "source:haedam-wazuh AND case_id:S7",
    "query_parameters": [],
    "filters": [],
    "streams": [
      "REPLACE_haedam-portal_stream_id"
    ],
    "group_by": [
      "event_key"
    ],
    "series": [
      {
        "id": "count()",
        "type": "count",
        "field": null
      }
    ],
    "conditions": {
      "expression": {
        "expr": ">",
        "left": {
          "expr": "number-ref",
          "ref": "count()"
        },
        "right": {
          "expr": "number",
          "value": 0
        }
      }
    },
    "search_within_ms": 120000,
    "execute_every_ms": 5000,
    "use_cron_scheduling": false,
    "event_limit": 100
  },
  "field_spec": {
    "event_key": {
      "data_type": "string",
      "providers": [
        {
          "type": "template-v1",
          "template": "${source.event_key}",
          "require_values": true
        }
      ]
    }
  },
  "key_spec": [
    "event_key"
  ],
  "notification_settings": {
    "grace_period_ms": 120000,
    "backlog_size": 0
  },
  "notifications": [],
  "storage": [
    {
      "type": "persist-to-streams-v1",
      "streams": [
        "000000000000000000000002"
      ]
    }
  ]
}
