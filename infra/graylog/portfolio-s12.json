{
  "input": {
    "title": "haedam-s12-lab GELF TCP",
    "type": "org.graylog2.inputs.gelf.tcp.GELFTCPInput",
    "global": true,
    "configuration": {
      "bind_address": "0.0.0.0",
      "port": 12201,
      "number_worker_threads": 2,
      "recv_buffer_size": 1048576,
      "max_message_size": 2097152,
      "tls_enable": false,
      "tcp_keepalive": true,
      "use_null_delimiter": true
    }
  },
  "stream": {
    "title": "haedam-s12-lab portal",
    "description": "Dedicated S1 GELF input",
    "matching_type": "AND",
    "remove_matches_from_default_stream": false,
    "rules": [
      {
        "type": 1,
        "field": "source",
        "value": "haedam-portal",
        "inverted": false,
        "description": "Portal source"
      }
    ]
  },
  "notification": {
    "title": "haedam-s12-lab authenticated S12",
    "description": "Personal S12 with measured health gate",
    "config": {
      "type": "http-notification-v2",
      "url": "http://n8n:5678/webhook/haedam-s12-respond",
      "method": "POST",
      "content_type": "JSON",
      "time_zone": "UTC",
      "headers": "",
      "basic_auth": null,
      "api_key_as_header": true,
      "api_key": "X-S12-Detection-Key",
      "api_secret": null,
      "skip_tls_verification": false,
      "body_template": "{\"case_id\": \"S12\", \"asset_id\": \"haedam-portal\", \"src_ip\": \"${event.fields.src_ip}\", \"event_id\": \"${event.id}\", \"detected_at\": \"${event.timestamp_processing}\"}"
    }
  },
  "definition": {
    "title": "haedam-s12-lab S12 measured request volume",
    "description": "Personal measured threshold; health gate is independently evaluated in n8n. Keep disabled until baseline is supplied.",
    "priority": 2,
    "alert": true,
    "config": {
      "type": "aggregation-v1",
      "query": "source:haedam-portal AND event_type:web.request AND src_ip:\"172.30.121.21\"",
      "query_parameters": [],
      "filters": [],
      "streams": [],
      "group_by": [
        "src_ip"
      ],
      "series": [
        {
          "id": "count()",
          "type": "count",
          "field": null
        }
      ],
      "conditions": {
        "expression": {
          "expr": ">",
          "left": {
            "expr": "number-ref",
            "ref": "count()"
          },
          "right": {
            "expr": "number",
            "value": null
          }
        }
      },
      "search_within_ms": 60000,
      "execute_every_ms": 30000,
      "use_cron_scheduling": false,
      "event_limit": 100
    },
    "field_spec": {
      "src_ip": {
        "data_type": "string",
        "providers": [
          {
            "type": "template-v1",
            "template": "${source.src_ip}",
            "require_values": true
          }
        ]
      },
      "case_id": {
        "data_type": "string",
        "providers": [
          {
            "type": "template-v1",
            "template": "S12",
            "require_values": true
          }
        ]
      }
    },
    "key_spec": [
      "src_ip"
    ],
    "notification_settings": {
      "grace_period_ms": 60000,
      "backlog_size": 0
    },
    "notifications": [],
    "storage": [
      {
        "type": "persist-to-streams-v1",
        "streams": [
          "000000000000000000000002"
        ]
      }
    ]
  },
  "schedule_enabled": false,
  "materialized": false,
  "required_message_fields": [
    "source",
    "event_type",
    "src_ip"
  ],
  "url_allowlist": {
    "id": "portfolio-s12",
    "type": "literal",
    "title": "S12 webhook",
    "value": "http://n8n:5678/webhook/haedam-s12-respond"
  },
  "baseline_required": true
}
