{
  "id": "haedamEffectReport01",
  "name": "[Portfolio S10] haedam-40 효과 확인 보고 수신",
  "active": false,
  "nodes": [
    {
      "id": "b9a6049b-774d-5868-a405-c813c633ea84",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "haedam-effect-report",
        "responseMode": "responseNode",
