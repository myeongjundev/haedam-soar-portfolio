    {
      "id": "c491b916-97b5-5007-bc84-fbc55c0a2052",
      "name": "보고 검증·기록 입력",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// 효과 확인 보고 수신: 각 자리의 시험 스크립트(공격 출발지가 403을 받는지 등)나 사람이 결과를 보내면 티켓의 해당 조치 줄에 effect를 기록한다.\nconst b = $input.first().json.body || {};\nif (b.seat !== 'B' || b.case_id !== 'S10' || b.asset_id !== 'haedam-portal' || b.group_key !== '203.0.113.22' || b.target !== '203.0.113.22' || b.via !== 'portal' || String(b.bot) !== '112' || b.action !== 'block') return [{json:{ok:false,bad:true,verdict:'invalid_input'}}];\nconst CFG = { dry_run: false, store_real: true };   // 실제 티켓 저장소에 쓰려면 false (A·C 연결 뒤)\nconst need = ['seat', 'case_id', 'group_key', 'asset_id', 'bot', 'via', 'action', 'target'];\nconst missing = need.filter(k => !b[k]);\nif (missing.length || typeof b.effect_verified !== 'boolean') return [{ json: { ok: false, error: { code: 'VALIDATION_ERROR', message: 'missing: ' + missing.concat(typeof b.effect_verified !== 'boolean' ? ['effect_verified(boolean)'] : []).join(',') } , bad: true } }];\nconst now = new Date().toISOString();\nreturn [{ json: { ctx: { cfg: CFG, reporter: b.reporter || null }, mode: 'record', stage: 'effect', seat: b.seat, case_id: b.case_id, group_key: b.group_key,\n  title: b.title || `${b.case_id} 효과 확인`, asset_id: b.asset_id, src_ip: b.src_ip || null, username: b.username || null,\n  event_ids: [b.event_id || `effect-${$execution.id}`], idempotency_key: `${$execution.id}-effect`,\n  action: { bot: String(b.bot), target: b.target, via: b.via, action: b.action, result: 'applied', applied_verified: b.applied_verified ?? null,\n    effect_verified: b.effect_verified, effect_verified_at: b.effect_verified_at || now, requested_at: now, finished_at: now,\n    n8n_execution_id: String($execution.id), detail: String(b.detail || '').slice(0, 300) } } }];\n"
      }
    },
    {
      "id": "c9e2256a-5090-54af-9c52-f4bbeb35d7f4",
      "name": "검증 통과?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cb11347d-a2ed-54f0-b6e5-ad2bf00a58d5",
              "leftValue": "={{ $json.bad !== true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5fed3e53-7674-5bc1-9a6d-15aeb14c7897",
      "name": "효과 기록 (haedam-10 effect)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        720,
        -60
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "haedamResultLog01",
          "mode": "id"
        },
        "options": {}
      }
    },
    {
      "id": "27757801-600b-55bf-8c91-682c91b7f72b",
      "name": "응답 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.bad) return [{ json: r }];\nreturn [{ json: { ok: r.ok, ticket_id: r.ticket_id || null, status: r.status || null, error: r.error || null, n8n_execution_id: $execution.id } }];\n"
      }
    },
    {
      "id": "728db901-8bb0-568c-a40f-cedf111fb4ef",
      "name": "응답",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {
          "responseCode": "={{ $json.ok === false || $json.bad === true || $json.verdict === 'invalid_input' ? ($json.verdict === 'invalid_input' || $json.bad === true ? 400 : 503) : ($json.verdict?.startsWith('held_') ? 409 : 200) }}"
        }
      }
    },
    {
      "id": "Current effect ticket input",
      "name": "Current effect ticket input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json; const id=$('Webhook').first().json.body.ticket_id;\nif (!/^T-\\d{8}-\\d{4}$/.test(id||'')) throw new Error('EFFECT_TICKET_REQUIRED');\nreturn [{json:{mode:'check',seat:r.seat,group_key:r.group_key,ctx:{cfg:r.ctx.cfg,expected_ticket_id:id,effect_record:r}}}];"
      }
    },
    {
      "id": "s8-effect-check",
      "name": "Check current effect ticket",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "haedamResultLog01",
          "mode": "id"
        },
        "options": {}
      }
    },
    {
      "id": "Match effect ticket",
      "name": "Match effect ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;\nif(r.ok!==true || !r.exists || r.ticket_id!==r.ctx.expected_ticket_id || !['responding','verified'].includes(r.status)) throw new Error('STALE_EFFECT_TICKET');\nreturn [{json:r.ctx.effect_record}];"
      }
    }
  ],
