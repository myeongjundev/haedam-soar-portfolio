{
  "schema_version": 1,
  "detection_enabled": false,
  "portal_url": "http://portal-response:5000",
  "ticket_url": "http://ticket-store:8088",
  "n8n_url": "http://n8n:5678",
  "respond_path": "haedam-s1-respond",
  "release_path": "haedam-s1-release",
  "operator_name": "portfolio-s1-operator",
  "event_max_age_seconds": 1860,
  "future_clock_tolerance_seconds": 30,
  "credentials": {
    "detection": {"id": "s1DetectionAuth", "header": "X-S1-Detection-Key", "env": "S1_DETECTION_KEY"},
    "operator": {"id": "s1OperatorAuth", "header": "X-S1-Operator-Key", "env": "S1_OPERATOR_KEY"},
    "portal": {"id": "s1PortalAuth", "header": "X-Response-Key", "env": "PORTAL_RESPONSE_KEY"},
    "ticket": {"id": "s1TicketAuth", "header": "X-Response-Key", "env": "TICKET_STORE_KEY"}
  }
}
